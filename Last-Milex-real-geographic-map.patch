+          const position = toLatLng(rider.latitude, rider.longitude);
+          if (!position) return null;
+          const isNeedsCheck = rider.status === 'needs_check' || rider.status === 'offline';
+          return <CircleMarker
+            key={`rider-${rider.profile_id}`}
+            center={position}
+            radius={7}
+            pathOptions={{ color: '#8d3e2f', weight: 2, fillColor: isNeedsCheck ? '#d39a39' : '#e15c43', fillOpacity: 0.96 }}
+          >
+            <Tooltip direction="top" offset={[0, -7]}>{rider.display_name ?? 'Rider'} · {rider.status.replaceAll('_', ' ')}</Tooltip>
+            <Popup>
+              <div className="geo-popup">
+                <strong>{rider.display_name ?? 'Rider'}</strong>
+                <span>Status: {rider.status.replaceAll('_', ' ')}</span>
+                <small>{heartbeatLabel(rider.last_heartbeat_at)}</small>
+                <small>{isDemo ? 'Static demo coordinate' : 'Last saved coordinate; GPS tracking is not enabled'}</small>
+              </div>
+            </Popup>
+          </CircleMarker>;
+        })}
+      </MapContainer> : <div className="geo-empty" role="status">
+        <MapIcon size={24} />
+        <strong>No saved map coordinates</strong>
+        <span>Add valid latitude/longitude to a shelter or rider record to place it on the map.</span>
+      </div>}
+
+      {(!online || tileFailed) && points.length > 0 && <div className="map-tile-notice" role="status" aria-live="polite">
+        {online ? 'Map tiles could not be loaded. Saved markers remain visible.' : 'Offline — map tiles need network access; showing saved coordinates only.'}
+      </div>}
+    </div>
+    <p className="map-summary" aria-live="polite">
+      {locatedShelters.length} shelters · {locatedRiders.length} riders with saved positions · {routes.length} mapped active routes of {activeAssignments} active assignments. Lines show direct links only.
+      {isDemo && ' Demo locations are static San Francisco fixtures.'}
+      {!online && ' The geographic basemap is unavailable offline.'}
+    </p>
+    <div className="flow-legend" aria-label="Map legend">
+      <span><i className="legend-rider" /> RIDER / LAST SAVED POSITION</span>
+      <span><i className="legend-shelter" /> SHELTER</span>
+      <span><i className="legend-route" /> ASSIGNMENT / DIRECT LINE</span>
+      <span className="map-count"><MapIcon size={12} /> {routes.length} MAPPED ROUTES</span>
     </div>
   </section>;
 }
