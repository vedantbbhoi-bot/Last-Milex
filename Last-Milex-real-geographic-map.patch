+import { describe, expect, it } from 'vitest';
+import type { Rider, Shelter, SubBatch } from '../../lib/types/domain';
+import { buildMapRoutes, straightLineDistanceKm, toLatLng } from './mapUtils';
+
+const rider: Rider = {
+  profile_id: 'rider-1',
+  status: 'busy',
+  vehicle_capacity: 40,
+  last_heartbeat_at: '2026-10-25T08:00:00.000Z',
+  latitude: 37.7833,
+  longitude: -122.4167,
+  display_name: 'Rider One',
+};
+
+const shelter: Shelter = {
+  id: 'shelter-1',
+  name: 'Shelter One',
+  capacity: 100,
+  current_demand: 20,
+  has_water: true,
+  has_fuel: true,
+  latitude: 37.7749,
+  longitude: -122.4194,
+};
+
+function makeSubBatch(overrides: Partial<SubBatch> = {}): SubBatch {
+  return {
+    id: 'sub-1',
+    batch_id: 'batch-1',
+    shelter_id: 'shelter-1',
+    rider_id: 'rider-1',
+    quantity: 20,
+    dependency: 'none',
+    status: 'in_transit',
+    expires_at: '2026-10-25T10:00:00.000Z',
+    claimed_at: null,
+    confirmation_deadline: null,
+    heartbeat_at: null,
+    picked_up_at: null,
+    delivered_at: null,
+    created_at: '2026-10-25T08:00:00.000Z',
+    ...overrides,
+  };
+}
+
+describe('map geometry helpers', () => {
+  it('accepts finite in-range latitude/longitude pairs only', () => {
+    expect(toLatLng(37.7, -122.4)).toEqual([37.7, -122.4]);
+    expect(toLatLng(null, -122.4)).toBeNull();
+    expect(toLatLng(Number.NaN, 0)).toBeNull();
+    expect(toLatLng(91, 0)).toBeNull();
+    expect(toLatLng(0, -181)).toBeNull();
+  });
+
+  it('maps only active assignments with both saved coordinates', () => {
+    const route = makeSubBatch();
+    const missingRiderLocation = { ...rider, profile_id: 'rider-2', latitude: null, longitude: null };
+    const result = buildMapRoutes(
+      [route, makeSubBatch({ id: 'available', status: 'available' }), makeSubBatch({ id: 'unmapped', rider_id: 'rider-2' })],
+      [rider, missingRiderLocation],
+      [shelter],
+    );
+
+    expect(result).toHaveLength(1);
+    expect(result[0]).toMatchObject({ item: { id: route.id }, rider: { profile_id: 'rider-1' }, shelter: { id: 'shelter-1' } });
+    expect(result[0].directKm).toBeGreaterThan(0);
+  });
+
+  it('computes a direct geodesic distance without claiming road mileage', () => {
+    const oneDegreeAtEquator = straightLineDistanceKm([0, 0], [0, 1]);
+    expect(oneDegreeAtEquator).toBeCloseTo(111.195, 2);
+    expect(straightLineDistanceKm([37.7749, -122.4194], [37.7749, -122.4194])).toBe(0);
+  });
+});
diff --git a/src/features/routing/mapUtils.ts b/src/features/routing/mapUtils.ts
new file mode 100644
index 0000000000000000000000000000000000000000..55a0902a7324e24287b9ecd434253bf611992a34
--- /dev/null
+++ b/src/features/routing/mapUtils.ts
@@ -0,0 +1,47 @@
+import type { Rider, Shelter, SubBatch } from '../../lib/types/domain';
+
+export type LatLng = [latitude: number, longitude: number];
+
+export interface MapRoute {
+  item: SubBatch;
+  rider: Rider;
+  shelter: Shelter;
+  from: LatLng;
+  to: LatLng;
+  directKm: number;
+}
+
+export function toLatLng(latitude: unknown, longitude: unknown): LatLng | null {
+  if (typeof latitude !== 'number' || typeof longitude !== 'number') return null;
+  if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return null;
+  if (latitude < -90 || latitude > 90 || longitude < -180 || longitude > 180) return null;
+  return [latitude, longitude];
+}
+
+export function straightLineDistanceKm(from: LatLng, to: LatLng): number {
+  const earthRadiusKm = 6371.0088;
+  const radians = (degrees: number) => (degrees * Math.PI) / 180;
+  const [fromLat, fromLon] = from.map(radians) as LatLng;
+  const [toLat, toLon] = to.map(radians) as LatLng;
+  const deltaLat = toLat - fromLat;
+  const deltaLon = toLon - fromLon;
+  const haversine = Math.sin(deltaLat / 2) ** 2
+    + Math.cos(fromLat) * Math.cos(toLat) * Math.sin(deltaLon / 2) ** 2;
+  return 2 * earthRadiusKm * Math.asin(Math.sqrt(Math.min(1, haversine)));
+}
+
+export function buildMapRoutes(subBatches: SubBatch[], riders: Rider[], shelters: Shelter[]): MapRoute[] {
+  const ridersById = new globalThis.Map(riders.map((rider) => [rider.profile_id, rider]));
+  const sheltersById = new globalThis.Map(shelters.map((shelter) => [shelter.id, shelter]));
+
+  return subBatches.flatMap((item) => {
+    if (!['claimed', 'in_transit'].includes(item.status) || !item.rider_id || !item.shelter_id) return [];
+    const rider = ridersById.get(item.rider_id);
+    const shelter = sheltersById.get(item.shelter_id);
+    if (!rider || !shelter) return [];
+    const from = toLatLng(rider.latitude, rider.longitude);
+    const to = toLatLng(shelter.latitude, shelter.longitude);
+    if (!from || !to) return [];
+    return [{ item, rider, shelter, from, to, directKm: straightLineDistanceKm(from, to) }];
+  });
+}
